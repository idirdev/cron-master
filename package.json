{
  "name": "cron-master",
  "version": "1.0.0",
  "description": "Cron job scheduler and manager with REST API, history, monitoring, and timezone support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cron-master": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/api.js",
    "lint": "tsc --noEmit",
